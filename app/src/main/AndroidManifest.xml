<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        One permission, asked for only when the button that needs it is pressed.

        COARSE, and not FINE: the app never receives a precise position rather than
        promising to round one it is holding, and what it stores is rounded further to
        two decimal places. A foraging patch is the thing to be careful with, and the
        journal only wants to know which hillside.

        Typing the place by hand remains the default and needs no permission at all;
        this is the shortcut, not the mechanism. CAMERA is still not here and does not
        need to be - the system camera is handed a FileProvider URI instead. INTERNET
        will arrive with iNaturalist, and not before.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands one write-once URI to whatever camera app the phone has, for one
            photograph at a time.

            This is why there is still no CAMERA permission. An app that declares
            CAMERA must then be granted it before the system camera will answer an
            intent; an app that does not declare it can hand over a file URI and get a
            picture back with no permission at all. The picture arrives either way,
            so the manifest stays empty.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
