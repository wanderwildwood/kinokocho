<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions yet. Two are planned and neither is granted here until the
         code that needs it exists, so that PRIVACY.md is never ahead of the app:

           CAMERA   - to attach photographs to an observation.
           INTERNET - only for pushing an observation to iNaturalist, on request.

         Location is deliberately absent. A foraging spot is sensitive, so location is
         typed in by hand rather than read from GPS - the same choice Birding made. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
