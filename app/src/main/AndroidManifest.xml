<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        One permission, asked for only when the button that needs it is pressed.

        COARSE, and not FINE: the app never receives a precise position rather than
        promising to round one it is holding, and what it stores is rounded further to
        two decimal places. A foraging patch is the thing to be careful with, and the
        journal only wants to know which hillside.

        Typing the place by hand remains the default and needs no permission at all;
        this is the shortcut, not the mechanism. CAMERA is still not here and does not
        need to be - the system camera is handed a FileProvider URI instead.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        No INTERNET here. The app works with no network: the journal, the photographs, the
        region pack and the key are all on the phone. Only a build made with an iNaturalist
        application id can publish a find, and only that build gets INTERNET, from
        src/inat/AndroidManifest.xml (see app/build.gradle.kts). A build without one, which
        is every build made from this repository as it stands, cannot reach the network.
    -->

    <!-- The apps that act on selected text, Define among them, for the menu over a selection. -->
    <queries>
        <!-- Home, whose dark mode switch this app follows when Home is installed. -->
        <package android:name="com.wanderwildwood.iori" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Cabinet (Files), whose own screens open a backup and save a copy. -->
        <package android:name="com.wanderwildwood.tana" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <!-- Starts dark mode before the first screen is drawn. Holds no data. -->
        <provider
            android:name="com.wanderwildwood.kinokocho.ui.DarkModeInit"
            android:authorities="${applicationId}.darkmodeinit"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands one write-once URI to whatever camera app the phone has, for one
            photograph at a time.

            This is why there is still no CAMERA permission. An app that declares
            CAMERA must then be granted it before the system camera will answer an
            intent; an app that does not declare it can hand over a file URI and get a
            picture back with no permission at all. The picture arrives either way,
            so the manifest stays empty.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
