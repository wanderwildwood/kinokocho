    <!-- iNaturalist: publishing a find, on the entry page -->

    <string name="inat_not_configured">This build has no iNaturalist application id, so it cannot publish.</string>
    <string name="inat_signed_out_body">Publishing a find puts it, its photographs and its characters on a public website, under your own account.</string>
    <string name="inat_sign_in">Sign in to iNaturalist</string>
    <!-- %1$s is the iNaturalist user name -->
    <string name="inat_signed_in_as">Signed in as %1$s</string>
    <string name="inat_sign_out">Sign out</string>
    <!-- When no browser can be opened. %1$s is inat_doing_sign_in or inat_doing_open -->
    <string name="inat_no_browser">There is no browser on this phone to %1$s with.</string>
    <string name="inat_doing_sign_in">sign in</string>
    <!-- "open that" = open the observation's page -->
    <string name="inat_doing_open">open that</string>
    <string name="inat_no_coordinates">No coordinates on this find</string>
    <!-- The quoted words are the button label place_take_position -->
    <string name="inat_no_coordinates_body">It will go up with the place in your own words and no map pin. iNaturalist cannot verify a find it cannot place, so it will sit outside the lists most identifiers work through. \"Add roughly where I am\", further up, fixes that.</string>
    <!-- The three location privacy settings; the Change button cycles them -->
    <string name="inat_location_hidden">Location: hidden</string>
    <string name="inat_location_obscured">Location: obscured</string>
    <string name="inat_location_exact">Location: exact</string>
    <string name="inat_location_hidden_body">iNaturalist is told where it was and shows nobody, including on the map. Nobody can check the record against the place.</string>
    <string name="inat_location_obscured_body">iNaturalist is told where it was and shows the public a random point within about twenty kilometres. The place you typed is kept, not shown.</string>
    <string name="inat_location_exact_body">The map pin is where you found it, and the place you typed is shown beside it. For anyone.</string>
    <!-- Button: change the location setting (verb) -->
    <string name="inat_location_change">Change</string>
    <!-- Publish is a two-tap action; this is the label after the first tap -->
    <string name="inat_publish_armed">Publish — this is public; tap again</string>
    <string name="inat_publish">Publish to iNaturalist</string>
    <!-- Heading once published (past participle). %1$s is a date -->
    <string name="inat_published_on">Published %1$s</string>
    <string name="inat_published">Published</string>
    <!-- %1$s is the name the iNaturalist community gave the find -->
    <string name="inat_says">iNaturalist says: %1$s</string>
    <!-- When that name was fetched ("read", past tense). %1$s is a date -->
