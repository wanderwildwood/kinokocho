    <string name="place_permission_refused">Not allowed. Type the place instead — it works just as well.</string>

    <!-- ============================================================ -->
    <!-- New entry: the questions asked while keying out a find -->

    <!-- Tappable line at the top that goes back to the journal (the app's name) -->
