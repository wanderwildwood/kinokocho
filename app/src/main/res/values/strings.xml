    <string name="entry_new_photo_count">Photo (%1$d)</string>
    <string name="entry_new_next">Next</string>

    <!-- ============================================================ -->
    <!-- Season: what is about this month, and looking a species up -->

    <!-- Title while a search is typed -->
    <string name="season_title_looking">Looking one up</string>
    <!-- Title. %1$s is the month name, e.g. "About in September" (about = around, out) -->
    <string name="season_title_month">About in %1$s</string>
    <string name="season_search_placeholder">Look one up, any month</string>
    <!-- %1$d species match the search, of %2$d in the region pack -->
    <string name="season_search_count">%1$d of %2$d match, whatever month they are out in.</string>
    <!-- %1$d species of %2$d have been recorded in month %3$s -->
    <string name="season_month_count">%1$d of %2$d in this region pack have been recorded in %3$s. Seasons are a guide and nothing more — fungi do not read calendars, and an out-of-season find is worth writing down precisely because it is one.</string>
    <string name="season_worth_knowing">Worth knowing this month</string>
    <string name="season_worth_knowing_body">The ones people go looking for and the ones that hurt people, which are often out at the same time. Sought after means people look for it, not that this app has told you anything is safe.</string>
    <!-- Heading over search results -->
    <string name="season_heading_found">Found</string>
    <!-- Heading over the rest of this month's species (about = around, out) -->
    <string name="season_heading_also_about">Also about</string>
    <string name="season_close">Close</string>
    <!-- Line under a dangerous species; its own note may follow after a space -->
    <string name="season_hazard_lethal">Can kill.</string>
    <string name="season_hazard_severe">Can cause serious harm.</string>
    <string name="season_hazard_gi">Makes people ill.</string>
    <string name="season_hazard_intoxicating">Intoxicating.</string>
    <!-- A sought-after species' line. %1$s is season_the_common_name or a scientific name, %2$s one of the season_harm_ phrases -->
    <string name="season_taken_for">Taken for %1$s, which %2$s.</string>
    <!-- A mushroom referred to by its common name within a sentence, e.g. "the Death Cap" -->
    <string name="season_the_common_name">the %1$s</string>
    <!-- Tail of season_taken_for: what the lookalike does to you -->
    <string name="season_harm_lethal">can kill</string>
    <string name="season_harm_severe">can cause serious harm</string>
    <string name="season_harm_gi">makes people ill</string>
    <string name="season_harm_intoxicating">is intoxicating</string>
    <string name="season_harm_other">is not a mushroom to eat</string>
    <!-- A sought-after species' line when it is confused with nothing dangerous -->
    <string name="season_sought_after">Sought after.</string>
    <!-- Added after a sought-after species' line, following a space -->
    <string name="season_sought_gi">Makes some people ill in its own right.</string>
    <string name="season_sought_intoxicating">Intoxicating in its own right.</string>
    <string name="season_sought_unknown">Nothing documented either way.</string>
    <!-- Row on the journal screen. %1$d species are about in month %2$s -->
    <string name="season_row">%1$d about in %2$s</string>

