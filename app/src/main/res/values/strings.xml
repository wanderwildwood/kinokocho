    <string name="journal_cd_about">About</string>
    <!-- Placeholder in the search field over the list: what can be searched for -->
    <string name="journal_search_placeholder">A name, a place, a month</string>
    <string name="journal_search_no_match">Nothing here matches that.</string>
    <!-- The main button: start recording a new mushroom (verb) -->
    <string name="journal_record_a_find">Record a find</string>
    <string name="journal_empty_title">Nothing recorded yet.</string>
    <string name="journal_empty_body">A find is worth recording even when you never learn what it was. Answer whatever you can see and leave the rest.</string>
