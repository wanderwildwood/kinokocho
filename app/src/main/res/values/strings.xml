    <string name="inat_check_names">Check what has been named</string>

    <!-- ============================================================ -->
    <!-- About dialog. Keep the names of the app, people, projects and licences as they are -->

    <!-- %1$s is the version number. 茸帳 (kinokochō) is the app's Japanese name -->
    <string name="about_title">茸帳 Mushroom Journal %1$s</string>
    <string name="about_what_it_is">A field journal. It records what you saw and narrows what it could be — often far enough that someone more experienced can say. It does not decide, it has no opinion about eating anything, and on a screen with no colour it could not be the one to decide anyway.</string>
    <string name="about_privacy">Nothing leaves this phone unless you send it. The only permission asked for is a rough position, only when you press the button for it, and only ever rough — never a precise fix.</string>
    <string name="about_inat">Publishing a find to iNaturalist is the one thing that reaches the network. One find, when you press a button that says it is public. Sign-in happens in your browser, so this app never sees your password.</string>
    <!-- "Obscured" is the location setting inat_location_obscured -->
    <string name="about_inat_obscured">Obscured is not the same as not sent: iNaturalist is told where the mushroom was and shows the public a point some twenty kilometres off. The place you typed is kept there too, and not shown.</string>
    <!-- The name of the app's licence -->
    <string name="about_licence">GNU General Public License v3</string>
    <string name="about_schema_credit">Character schema and drawings — original, this project.</string>
    <!-- A citation: the DELTA system by Watson and Dallwitz, 1974 -->
    <string name="about_delta_credit">Question order after Watson &amp; Dallwitz, DELTA, 1974.</string>
    <!-- Tappable: export a backup of the journal -->
    <string name="about_export">Keep a copy of everything</string>
    <string name="about_export_body">A zip of every find and every photograph, handed to whatever you keep things in. Plain JSON inside, readable without this app.</string>
    <!-- Tappable: import a backup -->
    <string name="about_import">Read a copy back in</string>
    <string name="about_import_body">Adds whatever is not already here. Nothing is deleted and nothing is overwritten, so an old copy read onto a full journal keeps both.</string>
    <!-- The donation link label, beside a drawing of a llama. A fixed phrase: a verb and an object, so the reader knows what pressing it does -->
    <string name="about_feed_the_llamas">Feed the llamas</string>
    <string name="about_no_browser">There is no browser on this phone to open that with.</string>
    <string name="about_close">Close</string>

