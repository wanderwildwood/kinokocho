    <!-- The same, with how many finds the journal holds -->
    <string name="entry_new_journal_link_count">Mushroom Journal · %1$d</string>
    <string name="entry_new_choose_many">Choose as many as apply.</string>
    <!-- Skip button for a character that could not be tested -->
    <string name="entry_new_cannot_say">I looked and cannot say</string>
    <string name="entry_new_skip">Skip this</string>
    <string name="entry_new_nothing_more">Nothing more to ask</string>
    <string name="entry_new_nothing_fits_done">Nothing fits everything you wrote down — a real mushroom against a description of a typical one. These come nearest, and one of the answers may be worth looking at again.</string>
    <string name="entry_new_all_answered">Every question that would tell these apart has been answered or skipped.</string>
    <string name="entry_new_add_photograph">Add a photograph</string>
