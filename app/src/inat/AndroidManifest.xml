<?xml version="1.0" encoding="utf-8"?>
<!--
    What only a build that can publish to iNaturalist needs. app/build.gradle.kts adds this
    file to the debug and release manifests when an iNaturalist application id is supplied,
    and not otherwise.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET, which arrived with iNaturalist and in the commit that first needed it,
        exactly as PRIVACY.md said it would.

        This file is merged only into a build made with an iNaturalist application id
        (app/build.gradle.kts); a build without one has neither the permission nor the
        activity below.

        It is used in one place: publishing a find you pressed a button to publish, and
        reading back what the community called it afterwards. There is no background
        sync, no analytics, no crash reporting and no telemetry.

        Unlike the location permission in the main manifest, this one is not a runtime
        permission - Android grants it at install and never asks. So it is worth saying plainly, here and in the About,
        that the app can reach the network: nothing on the phone is going to ask on its
        behalf.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- And it may speak https only: res/xml/network_security_config.xml beside this file. -->
    <application android:networkSecurityConfig="@xml/network_security_config">

        <!--
            Catches the browser coming back from iNaturalist.

            A separate activity rather than a second intent-filter on MainActivity,
            which would have meant giving the launcher activity a singleTask launch mode
            and changing how the whole app behaves on every ordinary start for the sake
            of one redirect a fortnight.

            No exported surface worth attacking: it reads the code out of the URI, hands
            it to the sign-in in progress and finishes. A code without the verifier that
            was minted alongside it - which never leaves this process - is worth
            nothing, which is the entire point of PKCE.

            android:taskAffinity="" and excludeFromRecents keep it out of the task
            switcher, so the browser bounce does not leave a stray card behind.
        -->
        <activity
            android:name=".net.INatRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kinokocho" android:host="oauth" />
            </intent-filter>
        </activity>
    </application>

</manifest>
